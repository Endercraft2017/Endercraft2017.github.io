# Copy to .env.local for local dev (`vercel dev` / `npm run ai:demo`).
# NEVER commit real values. In production these live in
# Railway → existing AFK3 service → Variables.

# --- SendFox: contact-form email (REQUIRED for the form to send) ---
SENDFOX_API_KEY=
INQUIRY_TO=contact@afkcube.com
# Use a verified afkcube.com sender for live inquiries. Sandbox sends only to your SendFox account email.
INQUIRY_FROM=AFK3 Website <onboarding@sendfoxmail.com>

# --- Vercel AI Gateway: optional AI triage on new inquiries ---
# Key from the Vercel dashboard → AI Gateway → API Keys.
# To use your own OpenAI key instead of Vercel billing, add it as a provider
# credential IN THE AI GATEWAY DASHBOARD — not here, not in code.
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-4o-mini

# --- Upstash Redis: per-IP rate limiting (RECOMMENDED for production) ---
# The Vercel Marketplace "Upstash for Redis" integration adds these automatically.
# If you add them manually, either name pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
